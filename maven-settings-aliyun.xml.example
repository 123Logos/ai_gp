<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy to: %USERPROFILE%\.m2\settings.xml
  (Or merge the <mirrors> block into your existing settings.xml)

  After saving, run again: .\mvnw.cmd spring-boot:run

  If you still get PKIX errors, the JVM still does not trust the HTTPS
  certificate chain — see BUILD-TROUBLESHOOTING.txt (SSL / corporate CA).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyunmaven</id>
      <mirrorOf>*</mirrorOf>
      <name>Aliyun public</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
  </mirrors>
</settings>
