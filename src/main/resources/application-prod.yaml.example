# 复制为 application-prod.yaml 后填写生产环境值（已被 .gitignore）。
# 建表：在 MySQL 中执行 md文档/数据库.md 中的 DDL。

server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/ai_gp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
    username: your_prod_db_user
    password: your_prod_db_password
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 30000

  jpa:
    show-sql: false
    hibernate:
      ddl-auto: validate

app:
  jwt:
    # 生产必须由运维注入环境变量 JWT_SECRET_KEY（≥32 字节），禁止写死在仓库、禁止与本地相同
    secret-key: ${JWT_SECRET_KEY}
  auth:
    verification-debug-return-code: false
  chat:
    default-provider: mimo
    providers:
      mimo:
        api-key: ${MIMO_API_KEY}
        base-url: https://api.xiaomimimo.com/v1
        model: mimo-v2-flash
      ollama:
        api-key: ""
        base-url: http://127.0.0.1:11434/v1
        model: ${OLLAMA_MODEL:qwen2.5}

logging:
  level:
    root: WARN
    com.aigp.demo: INFO
