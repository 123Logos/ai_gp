# ========================================
# 服务器生产配置模板 - 复制此文件为 application-prod.yaml 并填写真实值
# ========================================

server:
  port: 8080

# 数据库配置 (服务器 MySQL)
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ai_gp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
    username: your_prod_db_user
    password: your_prod_db_password
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 30000

  # MyBatis-Plus 配置
  mybatis-plus:
    mapper-locations: classpath:mapper/**/*.xml
    configuration:
      map-underscore-to-camel-case: true
      log-impl: org.apache.ibatis.logging.nologging.Slf4jImpl
    global-config:
      db-config:
        id-type: auto

  # AI 模型配置
  ai:
    openai:
      api-key: your_prod_api_key_here
      base-url: https://api.openai.com
      chat:
        options:
          model: gpt-4o

# JWT 密钥 - 生产环境必须修改
app:
  jwt:
    secret: your-prod-jwt-secret-at-least-256-bits-long
    expiration: 86400000  # 24小时 (毫秒)

# 日志级别
logging:
  level:
    root: WARN
    com.aigp.demo: INFO
