# 复制为 application-dev.yaml 后按需修改（该文件已被 .gitignore，不会提交）。
# 建表：在 MySQL 中执行 md文档/数据库.md 中的 DDL。

server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ai_gp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: your_password_here

  jpa:
    show-sql: true
    hibernate:
      ddl-auto: validate

logging:
  level:
    root: INFO
    com.aigp.demo: DEBUG
    org.hibernate.SQL: DEBUG
