# ========================================
# 本地开发配置模板 - 复制此文件为 application-dev.yaml 并填写真实值
# ========================================

server:
  port: 8080

# 数据库配置 (本地 MySQL)
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ai_planner_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_password_here
    driver-class-name: com.mysql.cj.jdbc.Driver

  # MyBatis-Plus 配置
  mybatis-plus:
    mapper-locations: classpath:mapper/**/*.xml
    configuration:
      map-underscore-to-camel-case: true
      log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    global-config:
      db-config:
        id-type: auto

  # AI 模型配置
  ai:
    openai:
      api-key: sk-your-api-key-here
      base-url: https://api.openai.com
      chat:
        options:
          model: gpt-4o

# JWT 密钥
app:
  jwt:
    secret: your-dev-jwt-secret-key
    expiration: 86400000  # 24小时 (毫秒)

# 日志级别
logging:
  level:
    root: INFO
    com.aigp.demo: DEBUG
    org.springframework.ai: DEBUG
